# Copiar como .env solo en el host de ejecución. Nunca versionar valores reales.
# Fase 1: usar DB_CONNECTION_STRING y API_KEY; mantener VAULT_HABILITADO=false.
# Fase 2: retirar DB_CONNECTION_STRING y API_KEY, cargar VAULT_* y usar true.

DB_CONNECTION_STRING=
API_KEY=
UIPATH_IP_ALLOWLIST=
# IP exacta o CIDR del operador autorizado en DEV; no reemplaza la IP de UiPath.
OPERADOR_IP_ALLOWLIST=

VAULT_HABILITADO=false
VAULT_ADDRESS=https://dev-app-vault.acity.com.pe
VAULT_TOKEN=
VAULT_PATH_DB=api-gestionludopatas/db
VAULT_PATH_APIKEY=api-gestionludopatas/apikey
# Ruta dentro del contenedor, solo si la CA interna no está en la confianza del sistema.
VAULT_CA_FILE=
# Solo transición DEV mientras SQL Server usa certificado autofirmado; false al instalar CA válida.
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
