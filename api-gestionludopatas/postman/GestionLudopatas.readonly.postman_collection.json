{
  "info": {
    "name": "GestionLudopatas.Api - Lecturas funcionales seguras",
    "description": "Dos búsquedas SICA de solo lectura. Un arreglo vacío es una respuesta funcional 200 válida; no crean ni reservan filas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "X-Api-Key", "type": "string" },
      { "key": "value", "value": "{{apiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(() => {",
          "  const isIngreso = pm.info.requestName === 'Lectura - SICA ingreso';",
          "  pm.test('Contrato funcional de solo lectura', function () {",
          "    pm.response.to.have.status(200);",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "    pm.expect(pm.response.headers.get('X-Trace-Id')).to.be.a('string').and.not.empty;",
          "    pm.expect(pm.response.headers.get('X-Correlation-Id')).to.eql(pm.variables.replaceIn('{{correlationId}}'));",
          "    const pendientes = pm.response.json();",
          "    pm.expect(pendientes).to.be.an('array');",
          "    pendientes.forEach((pendiente) => {",
          "      pm.expect(pendiente).to.include.all.keys('id', 'numeroDocumento', 'tipoDocumento', 'nombresApellidos', 'fechaInscripcion', 'corteId', 'ultimoCorteId', 'sicaReintentos');",
          "      pm.expect(pendiente.id).to.be.a('number');",
          "      if (isIngreso) pm.expect(pendiente.nombresApellidos).to.not.equal(null);",
          "    });",
          "  });",
          "})();"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Lectura - SICA ingreso",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maxReintentosPorSistema\": 3\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/pendientes/sica/ingresos/busqueda",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "v1", "pendientes", "sica", "ingresos", "busqueda" ]
        }
      }
    },
    {
      "name": "Lectura - SICA salida",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maxReintentosPorSistema\": 3\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/pendientes/sica/salidas/busqueda",
          "host": [ "{{baseUrl}}" ],
          "path": [ "api", "v1", "pendientes", "sica", "salidas", "busqueda" ]
        }
      }
    }
  ]
}
